{
  "manifest_version": 3,
  "name": "CHub Form Filler (QA)",
  "version": "1.3.1",
  "description": "Fills CommitteeHub submission forms with test data for manual testing.",
  "permissions": ["activeTab", "scripting", "storage"],
  "incognito": "spanning",
  "action": {
    "default_title": "CHub Form Filler",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Open CHub Form Filler"
    }
  }
}
